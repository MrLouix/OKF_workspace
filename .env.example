# OKF Workspace - Configuration d'environnement

# ===========================================
# Configuration LLM (Large Language Model)
# ===========================================
# Renseignez vos clés API pour les fournisseurs LLM
# Ne commitez JAMAIS ce fichier avec vos vraies clés !

# URL de l'API LLM
# Pour Mistral : https://api.mistral.ai/v1/chat/completions
# Pour Anthropic : https://api.anthropic.com/v1/messages
# Pour OpenAI : https://api.openai.com/v1/chat/completions
VITE_LLM_API_URL=https://api.mistral.ai/v1/chat/completions

# Modèle LLM à utiliser
# Mistral: mistral-large-2407, mistral-medium-2407, mistral-small-2407, mistral-tiny-2407
# Anthropic: claude-3-5-sonnet-20250620, claude-3-haiku-20240307, etc.
# OpenAI: gpt-4o-mini, gpt-4o, gpt-3.5-turbo, etc.
VITE_LLM_MODEL=mistral-large-2407

# Clé API pour le fournisseur LLM (priorité: VITE_LLM_API_KEY > spécifiques)
VITE_LLM_API_KEY=

# Mistral
VITE_MISTRAL_API_KEY=

# OpenAI (alternative)
VITE_OPENAI_API_KEY=

# Anthropic (alternative)
VITE_ANTHROPIC_API_KEY=

# ===========================================
# Configuration RAG (Retrieval-Augmented Generation) avec Qdrant
# ===========================================
# URL de Qdrant (ex: http://localhost:6333)
VITE_RAG_API_URL=http://localhost:6333

# Nom de la collection Qdrant contenant vos documents
VITE_QDRANT_COLLECTION=okf_documents

# Clé API pour Qdrant (optionnelle, Qdrant n'en nécessite pas par défaut)
VITE_RAG_API_KEY=

# Nombre de résultats à retourner par le RAG
VITE_RAG_TOP_K=5

# URL de l'API Mistral Embeddings (pour vectoriser les requêtes)
VITE_MISTRAL_EMBEDDINGS_URL=https://api.mistral.ai/v1/embeddings

# ===========================================
# Application
# ===========================================
# Port de développement (par défaut: 5173)
VITE_PORT=5173

# URL de base pour le déploiement
VITE_BASE_URL=/
