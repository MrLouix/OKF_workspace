# OKF Workspace - Configuration d'environnement

# ===========================================
# Configuration LLM (Large Language Model)
# ===========================================
# Renseignez vos clés API pour les fournisseurs LLM
# Ne commitez JAMAIS ce fichier avec vos vraies clés !

# OpenAI
VITE_OPENAI_API_KEY=sk-...

# Anthropic
VITE_ANTHROPIC_API_KEY=sk-ant-...

# ===========================================
# Configuration RAG (Retrieval-Augmented Generation)
# ===========================================
# URL de votre endpoint RAG
VITE_RAG_API_URL=https://votre-rag.example.com/retrieve

# Clé API pour votre endpoint RAG (si nécessaire)
VITE_RAG_API_KEY=your-rag-api-key

# ===========================================
# Application
# ===========================================
# Port de développement (par défaut: 5173)
VITE_PORT=5173

# URL de base pour le déploiement
VITE_BASE_URL=/
